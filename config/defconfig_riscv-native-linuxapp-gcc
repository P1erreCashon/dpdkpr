# SPDX-License-Identifier: BSD-3-Clause
# RISC-V 64-bit Linux target (native GCC)
# Simplified for native RISC-V, no cross-compilation

#include "common_linux"

# CPU & architecture
CONFIG_RTE_MACHINE="riscv_generic"
CONFIG_RTE_ARCH="riscv"
CONFIG_RTE_ARCH_RISCV=y
CONFIG_RTE_ARCH_RISCV64=y

# Toolchain
CONFIG_RTE_TOOLCHAIN="gcc"
CONFIG_RTE_TOOLCHAIN_GCC=y

# Force intrinsic functions and strict alignment
CONFIG_RTE_FORCE_INTRINSICS=y
CONFIG_RTE_ARCH_STRICT_ALIGN=y

# NUMA & hugepages (disable for generic RISC-V)
CONFIG_RTE_EAL_NUMA_AWARE_HUGEPAGES=n
CONFIG_RTE_LIBRTE_VHOST_NUMA=n

# Drivers not supported / disable default PMDs
CONFIG_RTE_LIBRTE_KNI=n
CONFIG_RTE_LIBRTE_ARK_PMD=n
CONFIG_RTE_LIBRTE_EM_PMD=n
CONFIG_RTE_LIBRTE_IGB_PMD=n
CONFIG_RTE_LIBRTE_CXGBE_PMD=n
CONFIG_RTE_LIBRTE_E1000_PMD=n
CONFIG_RTE_LIBRTE_ENIC_PMD=n
CONFIG_RTE_LIBRTE_FM10K_PMD=n
CONFIG_RTE_LIBRTE_I40E_PMD=n
CONFIG_RTE_LIBRTE_IXGBE_PMD=n
CONFIG_RTE_LIBRTE_VMXNET3_PMD=n
CONFIG_RTE_LIBRTE_QEDE_PMD=n
CONFIG_RTE_LIBRTE_SFC_EFX_PMD=n
CONFIG_RTE_LIBRTE_AVP_PMD=n
CONFIG_RTE_LIBRTE_NFP_PMD=n
CONFIG_RTE_LIBRTE_HINIC_PMD=n
CONFIG_RTE_LIBRTE_HNS3_PMD=n
CONFIG_RTE_LIBRTE_PMD_IOAT_RAWDEV=n
CONFIG_RTE_LIBRTE_IONIC_PMD=n

# Maximum cores / NUMA nodes (adjust if needed)
CONFIG_RTE_MAX_LCORE=8
CONFIG_RTE_MAX_NUMA_NODES=1

# Endianess
CONFIG_RTE_ARCH_LITTLE_ENDIAN=y

# Optional NEON-like memcpy (not applicable for RISC-V)
CONFIG_RTE_ARCH_ARM_NEON_MEMCPY=n